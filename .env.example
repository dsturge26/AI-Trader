# =====================================================================
#  AI-Trader configuration  —  COPY THIS FILE TO ".env" AND FILL IT IN
# =====================================================================
#
#  Step 1: copy this file:        cp .env.example .env
#  Step 2: paste your keys below
#  Step 3: leave ALPACA_PAPER=true  (fake money) until you REALLY mean it
#
#  The real ".env" file is git-ignored, so your secret keys never get
#  committed or pushed anywhere.
# ---------------------------------------------------------------------

# --- Your Alpaca API keys -------------------------------------------
# Get these from https://app.alpaca.markets/  (Paper Trading -> API Keys).
# A PAPER account and a LIVE account have DIFFERENT keys. Use the paper
# keys while ALPACA_PAPER=true.
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# --- THE SAFETY SWITCH ----------------------------------------------
# true  = PAPER trading = fake money. This is the safe default.
# false = LIVE trading = REAL money. The bot will print a loud warning
#         and force you to type a confirmation before it will start.
ALPACA_PAPER=true

# --- Which brain to run ----------------------------------------------
# swing    = the calm, once-a-day "buy the dip" investor (uses SYMBOL below).
# momentum = a DAY-TRADER: scans the whole market for the biggest gainers
#            ("pumps"), buys the strongest, and sells the SAME DAY on a
#            take-profit, a stop-loss, or just before the closing bell.
# NOTE: in momentum mode, set LOOP_INTERVAL_SECONDS low (e.g. 60) so it can
#       react fast, and the SMA/RSI knobs below are ignored.
STRATEGY=swing

# --- What to trade (SWING mode only) ---------------------------------
# One ticker symbol to keep things calm and simple to start.
# SPY = an ETF (a basket) that tracks the whole S&P 500 stock market.
# It's a popular, sane choice for a first bot because it's diversified.
# (Momentum mode ignores this — it scans the whole market instead.)
SYMBOL=SPY

# --- Hard money guardrails (US dollars) -----------------------------
# These are explained in plain English in the README. The bot will
# refuse to break them. You can make them STRICTER any time.
ACCOUNT_FLOOR=35            # Stop ALL trading if account equity falls below this
MAX_POSITION_NOTIONAL=25    # Never put more than this many dollars into the position
MAX_DAILY_LOSS=10           # Stop for the day if we're down this much from today's open

# --- SWING strategy knobs (sensible defaults; used when STRATEGY=swing) ---
SMA_TREND_PERIOD=50         # "Trend" moving average length, in days
RSI_PERIOD=14               # How many days the RSI meter looks back
RSI_BUY_BELOW=35            # Buy only when RSI is below this (stock looks "cheap")
RSI_SELL_ABOVE=70           # Sell when RSI rises above this (stock looks "expensive")

# --- MOMENTUM (day-trader) knobs (used when STRATEGY=momentum) -------
# The values below are the AGGRESSIVE profile. Lower the take-profit/stop and
# the min-gainer for a calmer day-trader.
TAKE_PROFIT_PCT=10          # Sell a winner once it's up this percent
STOP_LOSS_PCT=5             # Sell a loser once it's down this percent
MAX_OPEN_POSITIONS=5        # How many different movers to hold at once
MIN_GAINER_PCT=5            # Ignore movers smaller than this (% up today)
MAX_GAINER_PCT=1000         # Ignore movers bigger than this (cap mania; 1000 = no cap)
MIN_PRICE=2                 # Ignore stocks cheaper than this (skip penny junk)
SCAN_TOP=50                 # How many of the day's top movers to pull and rank
FLATTEN_MINUTES_BEFORE_CLOSE=10   # Sell EVERYTHING this many minutes before close
# Optional fallback: if your data plan has no market-movers feed, the scanner
# will instead watch just these tickers (comma-separated). Leave blank to rely
# on the live movers feed.
WATCHLIST=

# --- How often the loop wakes up ------------------------------------
# SWING mode: 900 (15 min) is plenty — it only acts once a day.
# MOMENTUM mode: use 60 (every minute) so take-profit/stop-loss react quickly.
LOOP_INTERVAL_SECONDS=900

# --- Web dashboard (dashboard.py) -----------------------------------
# Password-protect the dashboard with HTTP Basic Auth. Leave the password
# BLANK for an open dashboard on localhost only. You MUST set a strong
# password before exposing the dashboard to the internet (e.g. Tailscale
# Funnel). The username defaults to "admin" if you don't set one.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
